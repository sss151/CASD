        Console.WriteLine("--- Тест 6: Обратный итератор ---");
        Console.Write("Обратный порядок: ");
        var descIter = set.DescendingIterator();
        while (descIter.MoveNext())
            Console.Write(descIter.Current + " ");
        Console.WriteLine("\n");

