using System;
using System.Collections;
using System.Collections.Generic;
using System.Linq;

public delegate int TreeMapComparator<T>(T a, T b);

public class MyTreeMap<K, V> : IEnumerable<KeyValuePair<K, V>> where K : IComparable<K>
{
    private enum Color { Red, Black }

    private class Node
    {
        public K Key;
        public V Value;
        public Node Left;
        public Node Right;
        public Node Parent;
        public Color NodeColor;

        public Node(K key, V value, Color color, Node parent)
        {
            Key = key;
            Value = value;
            NodeColor = color;
            Parent = parent;
        }
    }

    private Node root;
    private int count;
    private readonly TreeMapComparator<K> comparator;

    public MyTreeMap()
    {
        comparator = (a, b) => a.CompareTo(b);
    }

    public MyTreeMap(TreeMapComparator<K> comp)
    {
        comparator = comp ?? ((a, b) => a.CompareTo(b));
    }

    public int Count => count;

    public void Put(K key, V value)
    {
        if (key == null)
            throw new ArgumentNullException(nameof(key));

        if (root == null)
        {
            root = new Node(key, value, Color.Black, null);
            count++;
            return;
        }

        Node current = root;
        Node parent = null;

        while (current != null)
        {
            parent = current;
            int cmp = comparator(key, current.Key);

            if (cmp < 0)
                current = current.Left;
            else if (cmp > 0)
                current = current.Right;
            else
            {
                current.Value = value;
                return;
            }
        }

        Node newNode = new Node(key, value, Color.Red, parent);
        int comparison = comparator(key, parent.Key);

        if (comparison < 0)
            parent.Left = newNode;
        else
            parent.Right = newNode;

        count++;
        FixInsert(newNode);
    }

    private void FixInsert(Node node)
    {
        while (node != root && GetColor(node.Parent) == Color.Red)
        {
            if (node.Parent == GetParent(node.Parent)?.Left)
            {
                Node uncle = GetParent(node.Parent)?.Right;

                if (GetColor(uncle) == Color.Red)
                {
                    SetColor(node.Parent, Color.Black);
                    SetColor(uncle, Color.Black);
                    SetColor(GetParent(node.Parent), Color.Red);
                    node = GetParent(node.Parent);
                }
                else
                {
                    if (node == node.Parent.Right)
                    {
                        node = node.Parent;
                        RotateLeft(node);
                    }

                    SetColor(node.Parent, Color.Black);
                    SetColor(GetParent(node.Parent), Color.Red);
                    RotateRight(GetParent(node.Parent));
                }
            }
            else
            {
                Node uncle = GetParent(node.Parent)?.Left;

                if (GetColor(uncle) == Color.Red)
                {
                    SetColor(node.Parent, Color.Black);
                    SetColor(uncle, Color.Black);
                    SetColor(GetParent(node.Parent), Color.Red);
                    node = GetParent(node.Parent);
                }
                else
                {
                    if (node == node.Parent.Left)
                    {
                        node = node.Parent;
                        RotateRight(node);
                    }

                    SetColor(node.Parent, Color.Black);
                    SetColor(GetParent(node.Parent), Color.Red);
                    RotateLeft(GetParent(node.Parent));
                }
            }
        }

        SetColor(root, Color.Black);
    }

    private Color GetColor(Node node)
    {
        return node == null ? Color.Black : node.NodeColor;
    }

    private void SetColor(Node node, Color color)
    {
        if (node != null)
            node.NodeColor = color;
    }

    private Node GetParent(Node node)
    {
        return node?.Parent;
    }

    private void RotateLeft(Node node)
    {
        if (node == null || node.Right == null) return;

        Node right = node.Right;
        node.Right = right.Left;

        if (right.Left != null)
            right.Left.Parent = node;

        right.Parent = node.Parent;

        if (node.Parent == null)
            root = right;
        else if (node == node.Parent.Left)
            node.Parent.Left = right;
        else
            node.Parent.Right = right;

        right.Left = node;
        node.Parent = right;
    }

    private void RotateRight(Node node)
    {
        if (node == null || node.Left == null) return;

        Node left = node.Left;
        node.Left = left.Right;

        if (left.Right != null)
            left.Right.Parent = node;

        left.Parent = node.Parent;

        if (node.Parent == null)
            root = left;
        else if (node == node.Parent.Right)
            node.Parent.Right = left;
        else
            node.Parent.Left = left;

        left.Right = node;
        node.Parent = left;
    }

    public bool ContainsKey(K key)
    {
        return FindNode(key) != null;
    }

    private Node FindNode(K key)
    {
        if (key == null)
            throw new ArgumentNullException(nameof(key));

        Node current = root;

        while (current != null)
        {
            int cmp = comparator(key, current.Key);

            if (cmp < 0)
                current = current.Left;
            else if (cmp > 0)
                current = current.Right;
            else
                return current;
        }

        return null;
    }

    public bool Remove(K key)
    {
        Node node = FindNode(key);
        if (node == null)
            return false;

        DeleteNode(node);
        count--;
        return true;
    }

    private void DeleteNode(Node node)
    {
        if (node == null) return;

        Node replacement;
        Node child;

        if (node.Left != null && node.Right != null)
        {
            replacement = GetMinNode(node.Right);
            node.Key = replacement.Key;
            node.Value = replacement.Value;
            node = replacement;
        }

        child = (node.Left != null) ? node.Left : node.Right;

        if (child != null)
        {
            ReplaceNode(node, child);

            if (GetColor(node) == Color.Black)
            {
                if (GetColor(child) == Color.Red)
                    SetColor(child, Color.Black);
                else
                    FixDelete(child);
            }
        }
        else
        {
            if (GetColor(node) == Color.Black)
                FixDelete(node);

            ReplaceNode(node, null);
        }
    }

    private void ReplaceNode(Node oldNode, Node newNode)
    {
        if (oldNode.Parent == null)
            root = newNode;
        else if (oldNode == oldNode.Parent.Left)
            oldNode.Parent.Left = newNode;
        else
            oldNode.Parent.Right = newNode;

        if (newNode != null)
            newNode.Parent = oldNode.Parent;
    }

    private void FixDelete(Node node)
    {
        while (node != root && GetColor(node) == Color.Black)
        {
            if (node == GetLeft(GetParent(node)))
            {
                Node sibling = GetRight(GetParent(node));

                if (GetColor(sibling) == Color.Red)
                {
                    SetColor(sibling, Color.Black);
                    SetColor(GetParent(node), Color.Red);
                    RotateLeft(GetParent(node));
                    sibling = GetRight(GetParent(node));
                }

                if (GetColor(GetLeft(sibling)) == Color.Black &&
                    GetColor(GetRight(sibling)) == Color.Black)
                {
                    SetColor(sibling, Color.Red);
                    node = GetParent(node);
                }
                else
                {
                    if (GetColor(GetRight(sibling)) == Color.Black)
                    {
                        SetColor(GetLeft(sibling), Color.Black);
                        SetColor(sibling, Color.Red);
                        RotateRight(sibling);
                        sibling = GetRight(GetParent(node));
                    }

                    SetColor(sibling, GetColor(GetParent(node)));
                    SetColor(GetParent(node), Color.Black);
                    SetColor(GetRight(sibling), Color.Black);
                    RotateLeft(GetParent(node));
                    node = root;
                }
            }
            else
            {
                Node sibling = GetLeft(GetParent(node));

                if (GetColor(sibling) == Color.Red)
                {
                    SetColor(sibling, Color.Black);
                    SetColor(GetParent(node), Color.Red);
                    RotateRight(GetParent(node));
                    sibling = GetLeft(GetParent(node));
                }

                if (GetColor(GetRight(sibling)) == Color.Black &&
                    GetColor(GetLeft(sibling)) == Color.Black)
                {
                    SetColor(sibling, Color.Red);
                    node = GetParent(node);
                }
                else
                {
                    if (GetColor(GetLeft(sibling)) == Color.Black)
                    {
                        SetColor(GetRight(sibling), Color.Black);
                        SetColor(sibling, Color.Red);
                        RotateLeft(sibling);
                        sibling = GetLeft(GetParent(node));
                    }

                    SetColor(sibling, GetColor(GetParent(node)));
                    SetColor(GetParent(node), Color.Black);
                    SetColor(GetLeft(sibling), Color.Black);
                    RotateRight(GetParent(node));
                    node = root;
                }
            }
        }

        SetColor(node, Color.Black);
    }

    private Node GetLeft(Node node) => node?.Left;
    private Node GetRight(Node node) => node?.Right;

    public void Clear()
    {
        root = null;
        count = 0;
    }

    public K GetFirstKey()
    {
        if (root == null)
            throw new InvalidOperationException("Tree is empty");
        return GetMinNode(root).Key;
    }

    public K GetLastKey()
    {
        if (root == null)
            throw new InvalidOperationException("Tree is empty");
        return GetMaxNode(root).Key;
    }

    private Node GetMinNode(Node node)
    {
        while (node?.Left != null)
            node = node.Left;
        return node;
    }

    private Node GetMaxNode(Node node)
    {
        while (node?.Right != null)
            node = node.Right;
        return node;
    }

    public K Ceiling(K key)
    {
        Node node = CeilingNode(key);
        return node != null ? node.Key : default(K);
    }

    private Node CeilingNode(K key)
    {
        Node current = root;
        Node result = null;

        while (current != null)
        {
            int cmp = comparator(key, current.Key);

            if (cmp < 0)
            {
                result = current;
                current = current.Left;
            }
            else if (cmp > 0)
            {
                current = current.Right;
            }
            else
            {
                return current;
            }
        }

        return result;
    }

    public K Floor(K key)
    {
        Node node = FloorNode(key);
        return node != null ? node.Key : default(K);
    }

    private Node FloorNode(K key)
    {
        Node current = root;
        Node result = null;

        while (current != null)
        {
            int cmp = comparator(key, current.Key);

            if (cmp > 0)
            {
                result = current;
                current = current.Right;
            }
            else if (cmp < 0)
            {
                current = current.Left;
            }
            else
            {
                return current;
            }
        }

        return result;
    }

    public K Higher(K key)
    {
        Node node = HigherNode(key);
        return node != null ? node.Key : default(K);
    }

    private Node HigherNode(K key)
    {
        Node current = root;
        Node result = null;

        while (current != null)
        {
            int cmp = comparator(key, current.Key);

            if (cmp < 0)
            {
                result = current;
                current = current.Left;
            }
            else
            {
                current = current.Right;
            }
        }

        return result;
    }

    public K Lower(K key)
    {
        Node node = LowerNode(key);
        return node != null ? node.Key : default(K);
    }

    private Node LowerNode(K key)
    {
        Node current = root;
        Node result = null;

        while (current != null)
        {
            int cmp = comparator(key, current.Key);

            if (cmp > 0)
            {
                result = current;
                current = current.Right;
            }
            else
            {
                current = current.Left;
            }
        }

        return result;
    }

    public K PollFirst()
    {
        if (root == null)
            return default(K);

        Node min = GetMinNode(root);
        K key = min.Key;
        Remove(key);
        return key;
    }

    public K PollLast()
    {
        if (root == null)
            return default(K);

        Node max = GetMaxNode(root);
        K key = max.Key;
        Remove(key);
        return key;
    }

    public IEnumerator<KeyValuePair<K, V>> GetEnumerator()
    {
        return InOrderTraversal(root).GetEnumerator();
    }

    IEnumerator IEnumerable.GetEnumerator()
    {
        return GetEnumerator();
    }

    private IEnumerable<KeyValuePair<K, V>> InOrderTraversal(Node node)
    {
        if (node != null)
        {
            foreach (var item in InOrderTraversal(node.Left))
                yield return item;

            yield return new KeyValuePair<K, V>(node.Key, node.Value);

            foreach (var item in InOrderTraversal(node.Right))
                yield return item;
        }
    }

    public IEnumerable<KeyValuePair<K, V>> ReverseInOrderTraversal()
    {
        return ReverseInOrderTraversal(root);
    }

    private IEnumerable<KeyValuePair<K, V>> ReverseInOrderTraversal(Node node)
    {
        if (node != null)
        {
            foreach (var item in ReverseInOrderTraversal(node.Right))
                yield return item;

            yield return new KeyValuePair<K, V>(node.Key, node.Value);

            foreach (var item in ReverseInOrderTraversal(node.Left))
                yield return item;
        }
    }

    public List<K> GetKeysInRange(K from, bool fromInclusive, K to, bool toInclusive)
    {
        List<K> result = new List<K>();
        GetKeysInRange(root, from, fromInclusive, to, toInclusive, result);
        return result;
    }

    private void GetKeysInRange(Node node, K from, bool fromInclusive, K to, bool toInclusive, List<K> result)
    {
        if (node == null)
            return;

        int cmpFrom = comparator(node.Key, from);
        int cmpTo = comparator(node.Key, to);

        if (cmpFrom > 0 || (cmpFrom == 0 && fromInclusive))
            GetKeysInRange(node.Left, from, fromInclusive, to, toInclusive, result);

        bool lowerOk = cmpFrom > 0 || (cmpFrom == 0 && fromInclusive);
        bool upperOk = cmpTo < 0 || (cmpTo == 0 && toInclusive);

        if (lowerOk && upperOk)
            result.Add(node.Key);

        if (cmpTo < 0 || (cmpTo == 0 && toInclusive))
            GetKeysInRange(node.Right, from, fromInclusive, to, toInclusive, result);
    }
}

public class MyTreeSet<T> : IEnumerable<T> where T : IComparable<T>
{
    private readonly MyTreeMap<T, object> m;
    private static readonly object PRESENT = new object();

    // 1. Конструктор
    public MyTreeSet()
    {
        m = new MyTreeMap<T, object>();
    }

    // 2. Конструктор с MyTreeMap
    public MyTreeSet(MyTreeMap<T, object> map)
    {
        m = map ?? throw new ArgumentNullException(nameof(map));
    }

    // 3. Конструктор с компаратором
    public MyTreeSet(TreeMapComparator<T> comparator)
    {
        m = new MyTreeMap<T, object>(comparator);
    }

    // 4. Конструктор с массивом
    public MyTreeSet(T[] array) : this()
    {
        if (array != null)
        {
            foreach (var item in array)
                Add(item);
        }
    }

    // 5. Конструктор с SortedSet
    public MyTreeSet(SortedSet<T> set) : this()
    {
        if (set != null)
        {
            foreach (var item in set)
                Add(item);
        }
    }

    // 6. Добавление элемента
    public bool Add(T element)
    {
        if (element == null)
            throw new ArgumentNullException(nameof(element));

        bool existed = m.ContainsKey(element);
        m.Put(element, PRESENT);
        return !existed;
    }

    // 7. Добавление элементов из массива
    public bool AddAll(T[] array)
    {
        if (array == null)
            throw new ArgumentNullException(nameof(array));

        bool modified = false;
        foreach (var item in array)
        {
            if (Add(item))
                modified = true;
        }
        return modified;
    }

    // 8. Очистка множества
    public void Clear()
    {
        m.Clear();
    }

    // 9. Проверка наличия элемента
    public bool Contains(object obj)
    {
        if (obj == null) return false;
        if (obj is T key)
            return m.ContainsKey(key);
        return false;
    }

    // 10. Проверка наличия всех элементов
    public bool ContainsAll(T[] array)
    {
        if (array == null)
            throw new ArgumentNullException(nameof(array));

        foreach (var item in array)
        {
            if (!Contains(item))
                return false;
        }
        return true;
    }

    // 11. Проверка на пустоту
    public bool IsEmpty()
    {
        return m.Count == 0;
    }

    // 12. Удаление элемента
    public bool Remove(object obj)
    {
        if (obj == null) return false;
        if (obj is T key)
            return m.Remove(key);
        return false;
    }

    // 13. Удаление элементов из массива
    public bool RemoveAll(T[] array)
    {
        if (array == null)
            throw new ArgumentNullException(nameof(array));

        bool modified = false;
        foreach (var item in array)
        {
            if (Remove(item))
                modified = true;
        }
        return modified;
    }

    // 14. Оставление только указанных элементов
    public bool RetainAll(T[] array)
    {
        if (array == null)
            throw new ArgumentNullException(nameof(array));

        var toRetain = new HashSet<T>(array);
        var toRemove = this.Where(item => !toRetain.Contains(item)).ToList();

        bool modified = toRemove.Count > 0;
        foreach (var item in toRemove)
            Remove(item);

        return modified;
    }

    // 15. Размер множества
    public int Size()
    {
        return m.Count;
    }

    // 16. Преобразование в массив
    public object[] ToArray()
    {
        object[] array = new object[m.Count];
        int index = 0;
        foreach (var item in this)
            array[index++] = item;
        return array;
    }

    // 17. Преобразование в типизированный массив
    public T[] ToArray(T[] array)
    {
        if (array == null)
            array = new T[m.Count];

        if (array.Length < m.Count)
            array = new T[m.Count];

        int index = 0;
        foreach (var item in this)
            array[index++] = item;

        return array;
    }

    // 18. Первый элемент
    public T First()
    {
        if (IsEmpty())
            throw new InvalidOperationException("Set is empty");
        return m.GetFirstKey();
    }

    // 19. Последний элемент
    public T Last()
    {
        if (IsEmpty())
            throw new InvalidOperationException("Set is empty");
        return m.GetLastKey();
    }

    // 20. Подмножество [fromElement, toElement)
    public MyTreeSet<T> SubSet(T fromElement, T toElement)
    {
        if (fromElement == null || toElement == null)
            throw new ArgumentNullException();

        if (fromElement.CompareTo(toElement) > 0)
            throw new ArgumentException("fromElement > toElement");

        return SubSet(fromElement, true, toElement, false);
    }

    // 21. Множество элементов меньших toElement
    public MyTreeSet<T> HeadSet(T toElement)
    {
        return HeadSet(toElement, false);
    }

    // 22. Множество элементов >= fromElement
    public MyTreeSet<T> TailSet(T fromElement)
    {
        return TailSet(fromElement, true);
    }

    // 23. Ceiling - наименьший элемент >= obj
    public T Ceiling(T obj)
    {
        if (obj == null)
            throw new ArgumentNullException(nameof(obj));
        return m.Ceiling(obj);
    }

    // 24. Floor - наибольший элемент <= obj
    public T Floor(T obj)
    {
        if (obj == null)
            throw new ArgumentNullException(nameof(obj));
        return m.Floor(obj);
    }

    // 25. Higher - наименьший элемент > obj
    public T Higher(T obj)
    {
        if (obj == null)
            throw new ArgumentNullException(nameof(obj));
        return m.Higher(obj);
    }

    // 26. Lower - наибольший элемент < obj
    public T Lower(T obj)
    {
        if (obj == null)
            throw new ArgumentNullException(nameof(obj));
        return m.Lower(obj);
    }

    // 27. HeadSet с включением
    public MyTreeSet<T> HeadSet(T upperBound, bool inclusive)
    {
        if (upperBound == null)
            throw new ArgumentNullException(nameof(upperBound));

        MyTreeSet<T> result = new MyTreeSet<T>();
        foreach (var item in this)
        {
            int cmp = item.CompareTo(upperBound);
            if (cmp < 0 || (cmp == 0 && inclusive))
                result.Add(item);
            else if (cmp > 0)
                break;
        }
        return result;
    }

    // 28. SubSet с параметрами включения
    public MyTreeSet<T> SubSet(T lowerBound, bool lowIncl, T upperBound, bool highIncl)
    {
        if (lowerBound == null)
            throw new ArgumentNullException(nameof(lowerBound));
        if (upperBound == null)
            throw new ArgumentNullException(nameof(upperBound));

        if (lowerBound.CompareTo(upperBound) > 0)
            throw new ArgumentException("lowerBound > upperBound");

        MyTreeSet<T> result = new MyTreeSet<T>();
        var keys = m.GetKeysInRange(lowerBound, lowIncl, upperBound, highIncl);

        foreach (var key in keys)
            result.Add(key);

        return result;
    }

    // 29. TailSet с включением
    public MyTreeSet<T> TailSet(T fromElement, bool inclusive)
    {
        if (fromElement == null)
            throw new ArgumentNullException(nameof(fromElement));

        MyTreeSet<T> result = new MyTreeSet<T>();
        foreach (var item in this)
        {
            int cmp = item.CompareTo(fromElement);
            if (cmp > 0 || (cmp == 0 && inclusive))
                result.Add(item);
        }
        return result;
    }

    // 30. PollLast - возврат и удаление последнего
    public T PollLast()
    {
        if (IsEmpty())
            return default(T);
        return m.PollLast();
    }

    // 31. PollFirst - возврат и удаление первого
    public T PollFirst()
    {
        if (IsEmpty())
            return default(T);
        return m.PollFirst();
    }

    // 32. Обратный итератор
    public IEnumerator<T> DescendingIterator()
    {
        foreach (var kvp in m.ReverseInOrderTraversal())
            yield return kvp.Key;
    }

    // 33. Обратное множество
    public MyTreeSet<T> DescendingSet()
    {
        MyTreeSet<T> result = new MyTreeSet<T>((a, b) => b.CompareTo(a));
        foreach (var item in this)
            result.Add(item);
        return result;
    }

    public IEnumerator<T> GetEnumerator()
    {
        foreach (var kvp in m)
            yield return kvp.Key;
    }

    IEnumerator IEnumerable.GetEnumerator()
    {
        return GetEnumerator();
    }

    public override string ToString()
    {
        return "[" + string.Join(", ", this) + "]";
    }
}

