        static void Main()
        {
            Console.WriteLine("=== 1. Транзитивное замыкание (DFS) ===");
            TransitiveClosure();

            Console.WriteLine("\n=== 10. Максимальный поток (Эдмондс-Карп) ===");
            MaxFlowDemo();

            Console.WriteLine("\n=== 13. Максимальная клика ===");
            MaxCliqueDemo();
