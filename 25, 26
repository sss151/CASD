using System;
using System.Collections.Generic;
using System.IO;

public class Entry<K, V>
{
    public K Key { get; set; }
    public V Value { get; set; }
    public Entry<K, V> Next { get; set; }

    public Entry(K key, V value)
    {
        Key = key;
        Value = value;
        Next = null;
    }
}

public class MyHashMap<K, V>
{
    private Entry<K, V>[] table;
    private int size;
    private float loadFactor;
    private int capacity;

    public MyHashMap()
    {
        capacity = 16;
        loadFactor = 0.75f;
        table = new Entry<K, V>[capacity];
        size = 0;
    }

    private int GetBucketIndex(K key)
    {
        if (key == null)
            throw new ArgumentNullException();

        int hashCode = key.GetHashCode();
        return Math.Abs(hashCode % capacity);
    }

    public void Put(K key, V value)
    {
        if ((float)size / capacity >= loadFactor)
        {
            Resize();
        }

        int bucketIndex = GetBucketIndex(key);

        Entry<K, V> current = table[bucketIndex];

        while (current != null)
        {
            if (current.Key.Equals(key))
            {
                current.Value = value;
                return;
            }

            current = current.Next;
        }

        Entry<K, V> newEntry = new Entry<K, V>(key, value);

        newEntry.Next = table[bucketIndex];
        table[bucketIndex] = newEntry;

        size++;
    }

    public V Remove(K key)
    {
        int bucketIndex = GetBucketIndex(key);

        Entry<K, V> current = table[bucketIndex];
        Entry<K, V> previous = null;

        while (current != null)
        {
            if (current.Key.Equals(key))
            {
                if (previous == null)
                {
                    table[bucketIndex] = current.Next;
                }
                else
                {
                    previous.Next = current.Next;
                }

                size--;
                return current.Value;
            }

            previous = current;
            current = current.Next;
        }

        return default(V);
    }

    public bool ContainsKey(K key)
    {
        int bucketIndex = GetBucketIndex(key);

        Entry<K, V> current = table[bucketIndex];

        while (current != null)
        {
            if (current.Key.Equals(key))
            {
                return true;
            }

            current = current.Next;
        }

        return false;
    }

    public HashSet<K> KeySet()
    {
        HashSet<K> keySet = new HashSet<K>();

        for (int i = 0; i < capacity; i++)
        {
            Entry<K, V> current = table[i];

            while (current != null)
            {
                keySet.Add(current.Key);
                current = current.Next;
            }
        }

        return keySet;
    }

    public int Size()
    {
        return size;
    }

    public bool IsEmpty()
    {
        return size == 0;
    }

    public void Clear()
    {
        table = new Entry<K, V>[capacity];
        size = 0;
    }

    private void Resize()
    {
        int newCapacity = capacity * 2;

        Entry<K, V>[] oldTable = table;

        table = new Entry<K, V>[newCapacity];
        capacity = newCapacity;
        size = 0;

        for (int i = 0; i < oldTable.Length; i++)
        {
            Entry<K, V> current = oldTable[i];

            while (current != null)
            {
                Put(current.Key, current.Value);
                current = current.Next;
            }
        }
    }
}

public class MyHashSet<T>
{
    private static readonly object PRESENT = new object();

    private MyHashMap<T, object> map;

    public MyHashSet()
    {
        map = new MyHashMap<T, object>();
    }

    public void Add(T e)
    {
        map.Put(e, PRESENT);
    }

    public bool Contains(T o)
    {
        return map.ContainsKey(o);
    }

    public bool Remove(T o)
    {
        return map.Remove(o) != null;
    }

    public int Size()
    {
        return map.Size();
    }

    public bool IsEmpty()
    {
        return map.IsEmpty();
    }

    public void Clear()
    {
        map.Clear();
    }

    public object[] ToArray()
    {
        object[] result = new object[Size()];
        int index = 0;

        foreach (T item in map.KeySet())
        {
            result[index++] = item;
        }

        return result;
    }
}

public class CustomString : IComparable<CustomString>
{
    public string Text { get; set; }

    public CustomString(string text)
    {
        Text = text;
    }

    private List<int> GetSortedWordLengths()
    {
        List<int> lengths = new List<int>();

        string[] words = Text.Split(
            new char[] { ' ' },
            StringSplitOptions.RemoveEmptyEntries
        );

        foreach (string word in words)
        {
            lengths.Add(word.Length);
        }

        lengths.Sort();

        return lengths;
    }

    public int CompareTo(CustomString other)
    {
        List<int> first = GetSortedWordLengths();
        List<int> second = other.GetSortedWordLengths();

        int min = Math.Min(first.Count, second.Count);

        for (int i = 0; i < min; i++)
        {
            if (first[i] < second[i])
                return -1;

            if (first[i] > second[i])
                return 1;
        }

        if (first.Count < second.Count)
            return -1;

        if (first.Count > second.Count)
            return 1;

        return 0;
    }

    public override bool Equals(object obj)
    {
        if (obj == null || !(obj is CustomString))
            return false;

        return CompareTo((CustomString)obj) == 0;
    }

    public override int GetHashCode()
    {
        List<int> lengths = GetSortedWordLengths();

        int hash = 17;

        foreach (int len in lengths)
        {
            hash = hash * 31 + len;
        }

        return hash;
    }

    public override string ToString()
    {
        return Text;
    }
}

class Program
{
    static void Main(string[] args)
    {
        MyHashSet<CustomString> set =
            new MyHashSet<CustomString>();

        try
        {
            string projectDir =
                Directory.GetParent(Directory.GetCurrentDirectory()).Parent.Parent.FullName;

            string filePath =
                Path.Combine(projectDir, "input.txt");

            string[] lines = File.ReadAllLines(filePath);

            foreach (string line in lines)
            {
                CustomString custom =
                    new CustomString(line);

                set.Add(custom);
            }

            Console.WriteLine("Строки во множестве:\n");

            foreach (object item in set.ToArray())
            {
                Console.WriteLine(item);
            }
        }
        catch (FileNotFoundException)
        {
            Console.WriteLine("Файл input.txt не найден");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}
