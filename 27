using System;
using System.Collections.Generic;
using System.IO;
using System.Text.RegularExpressions;

public class Entry<K, V>
{
    public K Key { get; set; }
    public V Value { get; set; }
    public Entry<K, V> Next { get; set; }

    public Entry(K key, V value)
    {
        Key = key;
        Value = value;
        Next = null;
    }
}

public class MyHashMap<K, V>
{
    private Entry<K, V>[] table;
    private int size;
    private float loadFactor;
    private int capacity;

    public MyHashMap()
    {
        capacity = 16;
        loadFactor = 0.75f;
        table = new Entry<K, V>[capacity];
        size = 0;
    }

    private int GetBucketIndex(K key)
    {
        if (key == null)
            throw new ArgumentNullException();

        int hashCode = key.GetHashCode();
        return Math.Abs(hashCode % capacity);
    }

    public void Put(K key, V value)
    {
        if ((float)size / capacity >= loadFactor)
        {
            Resize();
        }

        int bucketIndex = GetBucketIndex(key);

        Entry<K, V> current = table[bucketIndex];

        while (current != null)
        {
            if (current.Key.Equals(key))
            {
                current.Value = value;
                return;
            }

            current = current.Next;
        }

        Entry<K, V> newEntry = new Entry<K, V>(key, value);

        newEntry.Next = table[bucketIndex];
        table[bucketIndex] = newEntry;

        size++;
    }

    public V Remove(K key)
    {
        int bucketIndex = GetBucketIndex(key);

        Entry<K, V> current = table[bucketIndex];
        Entry<K, V> previous = null;

        while (current != null)
        {
            if (current.Key.Equals(key))
            {
                if (previous == null)
                {
                    table[bucketIndex] = current.Next;
                }
                else
                {
                    previous.Next = current.Next;
                }

                size--;
                return current.Value;
            }

            previous = current;
            current = current.Next;
        }

        return default(V);
    }

    public bool ContainsKey(K key)
    {
        int bucketIndex = GetBucketIndex(key);

        Entry<K, V> current = table[bucketIndex];

        while (current != null)
        {
            if (current.Key.Equals(key))
            {
                return true;
            }

            current = current.Next;
        }

        return false;
    }

    public HashSet<K> KeySet()
    {
        HashSet<K> keySet = new HashSet<K>();

        for (int i = 0; i < capacity; i++)
        {
            Entry<K, V> current = table[i];

            while (current != null)
            {
                keySet.Add(current.Key);
                current = current.Next;
            }
        }

        return keySet;
    }

    public int Size()
    {
        return size;
    }

    public bool IsEmpty()
    {
        return size == 0;
    }

    public void Clear()
    {
        table = new Entry<K, V>[capacity];
        size = 0;
    }

    private void Resize()
    {
        int newCapacity = capacity * 2;

        Entry<K, V>[] oldTable = table;

        table = new Entry<K, V>[newCapacity];
        capacity = newCapacity;
        size = 0;

        for (int i = 0; i < oldTable.Length; i++)
        {
            Entry<K, V> current = oldTable[i];

            while (current != null)
            {
                Put(current.Key, current.Value);
                current = current.Next;
            }
        }
    }
}

public class MyHashSet<T>
{
    private static readonly object PRESENT = new object();

    private MyHashMap<T, object> map;

    public MyHashSet()
    {
        map = new MyHashMap<T, object>();
    }

    public void Add(T e)
    {
        map.Put(e, PRESENT);
    }

    public bool Contains(T o)
    {
        return map.ContainsKey(o);
    }

    public bool Remove(T o)
    {
        return map.Remove(o) != null;
    }

    public int Size()
    {
        return map.Size();
    }

    public bool IsEmpty()
    {
        return map.IsEmpty();
    }

    public void Clear()
    {
        map.Clear();
    }

    public object[] ToArray()
    {
        object[] result = new object[Size()];
        int index = 0;

        foreach (T item in map.KeySet())
        {
            result[index++] = item;
        }

        return result;
    }
}

class Program
{
    static void Main(string[] args)
    {
        MyHashSet<string> set = new MyHashSet<string>();

        try
        {
            string projectDir =Directory.GetParent(Directory.GetCurrentDirectory()).Parent.Parent.FullName;

            string filePath = Path.Combine(projectDir, "input.txt");

            string[] lines = File.ReadAllLines(filePath);

            foreach (string line in lines)
            {
                MatchCollection matches = Regex.Matches(line, @"[A-Za-z]+");

                foreach (Match match in matches)
                {
                    string word = match.Value.ToLower();

                    set.Add(word);
                }
            }

            Console.WriteLine("Уникальные слова:\n");

            foreach (object word in set.ToArray())
            {
                Console.WriteLine(word);
            }

            Console.WriteLine("\nКоличество уникальных слов: " + set.Size()
            );
        }
        catch (FileNotFoundException)
        {
            Console.WriteLine("Файл input.txt не найден");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}
